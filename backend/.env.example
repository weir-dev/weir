# WEIR — Autonomous Solana Token Counting Station
PROJECT_NAME="WEIR"
ENVIRONMENT="production"
PORT=8000
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/weir_db"
POSTGRES_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/weir_db"
REDIS_URL="redis://localhost:6379/0"

# Solana RPC & DAS (Helius DAS for on-chain holder sampling & live mints)
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY"
HELIUS_API_KEY="YOUR_HELIUS_KEY"
DEXSCREENER_API_BASE="https://api.dexscreener.com/latest/dex"

# Network & Ingestion
DEFAULT_CHAIN="solana"
DEFAULT_CHAIN_LABEL="Solana Mainnet"
INGEST_WORKER_ENABLED="true"
MODEL_WORKER_ENABLED="true"

# Model & Four Locks
ENTRY_MC_USD=10000
CLEAR_MC_USD=30000
HOLD_AFTER_HOURS=48
CAPACITY_D=37
AUC_TARGET=0.60
AUC_FLOOR=0.50
DELTA_CONFIDENCE=0.05
GATE_N_SAMPLES=2000
GATE_N_POSITIVE=200
GATE_AUC_STD_MAX=0.05
GATE_TIME_SPLIT_GAP_MAX=0.04
GATE_LEVEL_CAP=0.95

# Token (filled at launch)
WEIR_TOKEN_MINT=""
WEIR_DEXSCREENER_URL=""

# Social / Twitter v2
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""
TWITTER_BEARER_TOKEN=""
TWITTER_AUTO_POST_ENABLED="false"
TWITTER_POST_INTERVAL_HOURS=2
TWITTER_MANAGED_BY_HANDLE="@weircount"
